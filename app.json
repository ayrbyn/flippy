{
  "expo": {
    "name": "flippy",
    "slug": "flippy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/flippy-app-icon.png",
    "scheme": "flippy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/flippy-app-icon.png"
    },
    "android": {
      "icon": "./assets/images/flippy-app-icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#FFF9EF",
        "foregroundImage": "./assets/images/flippy-mascot-foreground.png",
        "monochromeImage": "./assets/images/flippy-mascot-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/flippy-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF9EF",
          "image": "./assets/images/flippy-mascot-foreground.png",
          "imageWidth": 150
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
