{
  "expo": {
    "name": "flippy",
    "slug": "flippy",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/flippy-app-icon.png",
    "scheme": "flippy",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/flippy-app-icon.png"
    },
    "android": {
      "versionCode": 2,
      "icon": "./assets/images/flippy-app-icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#FFF9EF",
        "foregroundImage": "./assets/images/flippy-mascot-foreground.png",
        "monochromeImage": "./assets/images/flippy-mascot-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.abyan7716.flippy"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/flippy-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF9EF",
          "image": "./assets/images/flippy-mascot-foreground.png",
          "imageWidth": 150
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "68b27adb-2ad2-423c-9d91-d125a691d984"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/68b27adb-2ad2-423c-9d91-d125a691d984"
    }
  }
}
